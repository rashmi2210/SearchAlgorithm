# Hierarchical Clustering (Python Fiddle Compatible)

from sklearn.cluster import AgglomerativeClustering
import pandas as pd

# -------------------------------
# Create dataset (same as record)
# -------------------------------
data = pd.DataFrame({
    'Hair':     [1, 1, 0, 0, 1, 0],
    'Feathers': [0, 0, 1, 1, 0, 0],
    'Eggs':     [0, 0, 1, 1, 0, 1],
    'Milk':     [1, 1, 0, 0, 1, 0]
})

# -------------------------------
# Apply Hierarchical Clustering
# -------------------------------
hierarchical = AgglomerativeClustering(n_clusters=2)
labels = hierarchical.fit_predict(data)

# -------------------------------
# Output (same format as record)
# -------------------------------
print("Output")
print(labels)
