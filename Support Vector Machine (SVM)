# SVM Classifier (Apples vs Oranges)

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# Create dataset (same idea as lab manual)
data = {
    'Weight': [150, 170, 140, 130, 160, 180, 120, 110],
    'Size':   [7,   8,   6,   5,   7,   9,   5,   4],
    'Class':  ['Apple','Apple','Apple','Apple','Orange','Orange','Orange','Orange']
}

df = pd.DataFrame(data)

print("Sample Dataset:")
print(df)

# Splitting dataset
from sklearn.model_selection import train_test_split
train_set, test_set = train_test_split(df, test_size=0.2, random_state=1)

# Features and target
X_train = train_set.iloc[:, :2].values
Y_train = train_set.iloc[:, 2].values
X_test = test_set.iloc[:, :2].values
Y_test = test_set.iloc[:, 2].values

# Encode labels
from sklearn.preprocessing import LabelEncoder
le = LabelEncoder()
Y_train = le.fit_transform(Y_train)
Y_test = le.transform(Y_test)

# Train SVM model
from sklearn.svm import SVC
classifier = SVC(kernel='rbf', random_state=1)
classifier.fit(X_train, Y_train)

# Prediction
Y_pred = classifier.predict(X_test)

# Attach predictions
test_set = test_set.copy()
test_set['Predictions'] = le.inverse_transform(Y_pred)

print("\nPredictions:")
print(test_set)

# Accuracy using confusion matrix
from sklearn.metrics import confusion_matrix
cm = confusion_matrix(Y_test, Y_pred)

accuracy = float(cm.diagonal().sum()) / len(Y_test)
print("\nAccuracy of SVM:", accuracy)

# Visualization
from matplotlib.colors import ListedColormap

X_set, Y_set = X_train, Y_train

X1, X2 = np.meshgrid(
    np.arange(start=X_set[:,0].min()-1, stop=X_set[:,0].max()+1, step=1),
    np.arange(start=X_set[:,1].min()-1, stop=X_set[:,1].max()+1, step=1)
)

plt.contourf(X1, X2, classifier.predict(np.array([X1.ravel(), X2.ravel()]).T).reshape(X1.shape),
             alpha=0.75, cmap=ListedColormap(('red','orange')))

plt.xlim(X1.min(), X1.max())
plt.ylim(X2.min(), X2.max())

for i, j in enumerate(np.unique(Y_set)):
    plt.scatter(X_set[Y_set == j, 0], X_set[Y_set == j, 1],
                c=ListedColormap(('red','orange'))(i), label=le.classes_[i])

plt.title('Apples vs Oranges')
plt.xlabel('Weight (grams)')
plt.ylabel('Size (cm)')
plt.legend()
plt.show()
